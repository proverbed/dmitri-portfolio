---
import Base from "../../layouts/Base.astro";
import WorkCard from "../../components/WorkCard.astro";
import { getCaseStudies } from "../../lib/work";

const studies = await getCaseStudies();
---

<Base
  title="Work"
  description="Selected work: a multi-tenant commerce platform, an aircraft edge fleet, a retail business, and an enterprise scheduling system."
  width="annotated"
>
  <header class="head">
    <h1>Work</h1>
    <p class="lede">
      Four systems, most recent first. Each covers what it was for, what made it
      hard, and what I would tell someone starting the same job.
    </p>
  </header>

  <div class="list">
    {studies.map((entry) => <WorkCard entry={entry} />)}
  </div>
</Base>

<style>
  .head {
    margin-block-end: calc(var(--spacing) * 12);
  }

  .head h1 {
    font-size: var(--text-h1);
  }

  .lede {
    margin-block-start: calc(var(--spacing) * 6);
    max-width: var(--container-measure);
    font-size: var(--text-lede);
    line-height: var(--leading-snug);
    color: var(--color-muted);
  }

  .head::after {
    content: "";
    display: block;
    height: 2px;
    margin-block-start: calc(var(--spacing) * 8);
    background-color: var(--color-accent);
  }

  .list {
    border-bottom: 1px solid var(--color-rule);
  }
</style>
