---
import Base from "../layouts/Base.astro";
import { getPublishedArticles } from "../lib/writing";

const hasPublishedWriting = (await getPublishedArticles()).length > 0;
---

<Base title="Page not found" description="That page does not exist." noindex width="measure">
  <h1 class="page-title">Page not found</h1>
  <p>
    That URL does not exist. It may have moved, or it may never have existed.
  </p>
  <ul class="links">
    {hasPublishedWriting && <li><a href="/writing">All writing</a></li>}
    <li><a href="/work">Selected work</a></li>
    <li><a href="/">Home</a></li>
  </ul>
</Base>

<style>
  .page-title {
    font-size: var(--text-h2);
    margin-block-end: calc(var(--spacing) * 6);
  }

  .links {
    margin-block-start: calc(var(--spacing) * 8);
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .links li {
    padding-block: calc(var(--spacing) * 3);
    border-top: 1px solid color-mix(in srgb, var(--color-rule) 55%, transparent);
  }
</style>
