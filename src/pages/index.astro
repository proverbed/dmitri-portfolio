---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { formatDate, isoDate } from "../lib/format";
import { SITE } from "../lib/site";
import { getArticles, getPublishedArticles } from "../lib/writing";
import { getCaseStudies } from "../lib/work";

const articles = (await getArticles()).slice(0, 3);
const hasPublishedWriting = (await getPublishedArticles()).length > 0;
const studies = await getCaseStudies();
const ogImage = new URL("/og/site/index.png", Astro.site ?? SITE.url).href;
---

<Base title={SITE.name} description={SITE.description} width="annotated" ogImage={ogImage}>
  {/* The masthead already carries the name. The largest type on the page is
      the claim, which is the thing a reader is here to evaluate. */}
  <header class="head">
    <p class="label kicker">{SITE.role}</p>
    <h1>{SITE.thesis}</h1>
  </header>

  <p class="intro">
    Currently building and running event-driven systems on AWS in TypeScript,
    end to end. That means a multi-tenant commerce platform — seventeen
    serverless services, a Next.js admin app and an Astro storefront — where I
    own the multi-tenant authentication, the per-tenant site build pipeline and
    the CI/CD promotion flow. Before that, four years on inflight retail
    software deployed to hardware on aircraft, and five years running my own
    e-commerce business.
    {/* TODO: restore once something is published —
       "I write here occasionally about the parts of the work that were
       harder than they looked." */}
  </p>

  <Section label="Selected work" id="selected-work" first>
    <ul class="index">
      {
        studies.map((study) => (
          <li>
            <a href={`/work/${study.id}`}>{study.data.title}</a>
            <span class="period label">{study.data.period}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    (hasPublishedWriting || articles.length > 0) && (
      <Section label="Writing" id="recent-writing">
        {articles.length === 0 && <p class="empty">Nothing published yet.</p>}

        <ul class="index">
          {
            articles.map((article) => (
              <li>
                <a href={`/writing/${article.id}`}>{article.data.title}</a>
                <span class="period label">
                  <time datetime={isoDate(article.data.publishDate)}>
                    {formatDate(article.data.publishDate)}
                  </time>
                </span>
              </li>
            ))
          }
        </ul>

        {hasPublishedWriting && (
          <p class="more label">
            <a href="/writing">All writing</a>
          </p>
        )}
      </Section>
    )
  }
</Base>

<style>
  .head {
    max-width: calc(var(--margin-column) + var(--gutter) + var(--container-measure));
  }

  .kicker {
    margin-block-end: calc(var(--spacing) * 5);
  }

  .head h1 {
    font-size: var(--text-h1);
  }

  .head::after {
    content: "";
    display: block;
    height: 2px;
    margin-block-start: calc(var(--spacing) * 8);
    background-color: var(--color-accent);
  }

  .intro {
    margin-block-start: calc(var(--spacing) * 8);
    max-width: var(--container-measure);
  }

  .index {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(var(--spacing) * 3);
    padding-block: calc(var(--spacing) * 3);
  }

  .index li + li {
    border-top: 1px solid color-mix(in srgb, var(--color-rule) 55%, transparent);
  }

  .index a {
    box-shadow: none;
    line-height: var(--leading-snug);
  }

  .index a:hover {
    box-shadow: inset 0 -2px 0 0 var(--color-accent);
  }

  .period {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .more {
    margin-block-start: calc(var(--spacing) * 5);
  }

  .more a {
    color: inherit;
  }

  .empty {
    color: var(--color-muted);
    font-size: var(--text-small);
  }
</style>
