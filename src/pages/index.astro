---
import Base from "../layouts/Base.astro";
import { formatDate, isoDate } from "../lib/format";
import { SITE } from "../lib/site";
import { getArticles } from "../lib/writing";
import { getCaseStudies } from "../lib/work";

const articles = (await getArticles()).slice(0, 3);
const studies = await getCaseStudies();
---

<Base title={SITE.name} description={SITE.description} width="annotated">
  <header class="head">
    <h1>{SITE.name}</h1>
    <p class="positioning">{SITE.role}</p>
  </header>

  <p class="intro">
    I build and run event-driven systems on AWS in TypeScript, end to end. Right
    now that means a multi-tenant commerce platform — seventeen serverless
    services, a Next.js admin app and an Astro storefront — where I own the
    multi-tenant authentication, the per-tenant site build pipeline and the CI/CD
    promotion flow. Before that I spent four years on inflight retail software
    deployed to hardware on aircraft, and five years running my own e-commerce
    business. I write here occasionally about the parts of the work that were
    harder than they looked.
  </p>

  {/* Two routes in, separated structurally rather than decoratively. */}
  <div class="routes">
    <section aria-labelledby="selected-work">
      <h2 id="selected-work" class="label">Selected work</h2>
      <ul class="index">
        {
          studies.map((study) => (
            <li>
              <a href={`/work/${study.id}`}>{study.data.title}</a>
              <span class="period label">{study.data.period}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="recent-writing">
      <h2 id="recent-writing" class="label">Writing</h2>

      {articles.length === 0 && <p class="empty">Nothing published yet.</p>}

      <ul class="index">
        {
          articles.map((article) => (
            <li>
              <a href={`/writing/${article.id}`}>{article.data.title}</a>
              <span class="period label">
                <time datetime={isoDate(article.data.publishDate)}>
                  {formatDate(article.data.publishDate)}
                </time>
              </span>
            </li>
          ))
        }
      </ul>

      <p class="more label"><a href="/writing">All writing</a></p>
    </section>
  </div>
</Base>

<style>
  .head h1 {
    font-size: var(--text-h1);
  }

  .positioning {
    margin-block-start: calc(var(--spacing) * 5);
    font-size: var(--text-lede);
    line-height: var(--leading-snug);
    color: var(--color-muted);
    max-width: var(--container-measure);
  }

  .head::after {
    content: "";
    display: block;
    height: 2px;
    margin-block-start: calc(var(--spacing) * 8);
    background-color: var(--color-accent);
  }

  .intro {
    margin-block-start: calc(var(--spacing) * 8);
    max-width: var(--container-measure);
  }

  .routes {
    display: grid;
    gap: calc(var(--spacing) * 12);
    margin-block-start: calc(var(--spacing) * 16);
  }

  @media (min-width: 64rem) {
    .routes {
      grid-template-columns: 1fr 1fr;
      gap: var(--gutter);
    }
  }

  .routes section {
    padding-block-start: calc(var(--spacing) * 5);
    border-top: 1px solid var(--color-rule);
  }

  .index {
    margin: calc(var(--spacing) * 5) 0 0;
    padding: 0;
    list-style: none;
  }

  .index li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(var(--spacing) * 3);
    padding-block: calc(var(--spacing) * 3);
  }

  .index li + li {
    border-top: 1px solid color-mix(in srgb, var(--color-rule) 55%, transparent);
  }

  .index a {
    box-shadow: none;
    line-height: var(--leading-snug);
  }

  .index a:hover {
    box-shadow: inset 0 -2px 0 0 var(--color-accent);
  }

  .period {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .more {
    margin-block-start: calc(var(--spacing) * 5);
  }

  .more a {
    color: inherit;
  }

  .empty {
    margin-block-start: calc(var(--spacing) * 5);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
</style>
