---
import Base from "../layouts/Base.astro";
import RoleEntry from "../components/RoleEntry.astro";
import { EDUCATION, ROLES, UNIVERSITY } from "../lib/cv";
import { encodeMailto, encodeText } from "../lib/email";
import { SITE, SOCIALS } from "../lib/site";

const currentRole = ROLES[0];

// Assembled as one HTML string so no JSX whitespace lands between the last link
// and the full stop. The address is encoded rather than written literally.
const contactLine = [
  "Available for senior engineering roles &#8212; ",
  `<a href="${encodeMailto(SITE.email)}">${encodeText(SITE.email)}</a>, `,
  SOCIALS.map((social) => `<a href="${social.href}" rel="me">${social.label}</a>`).join(
    " and ",
  ),
  ".",
].join("");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  jobTitle: currentRole?.title,
  worksFor: currentRole
    ? { "@type": "Organization", name: currentRole.company }
    : undefined,
  alumniOf: { "@type": "CollegeOrUniversity", name: UNIVERSITY },
  sameAs: SOCIALS.map((social) => social.href),
  // Deliberately no `email` property: the point of encoding it in the markup is
  // defeated by publishing it in plain text a few lines further down the page.
};
---

<Base
  title="About"
  description="Full-stack engineer in Cape Town, fifteen years in, working mostly in TypeScript across the stack."
  width="measure"
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <h1 class="page-title">About</h1>

  <div class="bio">
    <p>
      I'm a full-stack engineer based in Cape Town, fifteen years in, working
      mostly in TypeScript across the stack — React and Next.js on the front, AWS
      serverless behind.
    </p>

    <p>
      I'm currently a Senior Engineer at Zebra Renewables, working on the UK side
      of the business. I'm a core engineer on a commercial multi-tenant commerce
      and ERP platform, where I designed the multi-tenant authentication, built
      the per-website static-site build pipeline, and redesigned the CI/CD
      promotion flow. I also line-manage two junior engineers. For most of my
      first year there I kept the previous generation of the platform running in
      production while we built its replacement — two systems at once, one of
      them carrying live revenue.
    </p>

    <p>
      Before that I spent nearly four years at Blackswan on inflight retail
      across three airlines. The backend ran on a small machine installed on each
      aircraft, syncing in scheduled windows between flights and activating above
      a set altitude, with cabin crew taking orders on Bluetooth-paired handsets.
      Fully offline for the duration of a flight, with no way to roll anything
      back mid-air. It remains the most interesting set of constraints I've
      worked under.
    </p>

    <p>
      I also founded and ran Tradedeal, an e-commerce business, for five years —
      two sales channels, my own inventory and order system, and every
      operational decision landing on me. It taught me more about trade-offs than
      any engineering role has.
    </p>

    <p>
      Earlier: five and a half years at Ambition 24 Hours building an enterprise
      system for a UK nursing agency, where I first led other developers.
    </p>

    <p>
      BSc and BSc (Hons) in Computer Science, University of the Western Cape,
      Dean's Merit List.
    </p>

    <p>
      I care most about correctness in systems where being wrong costs someone
      real money, and about making fast delivery safe rather than treating those
      as a trade-off.
    </p>
  </div>

  <section class="section" aria-labelledby="career">
    <h2 id="career">Career</h2>
    {ROLES.map((role) => <RoleEntry role={role} />)}
  </section>

  <section class="section" aria-labelledby="education">
    <h2 id="education">Education</h2>

    <dl class="education">
      {
        EDUCATION.map((qualification) => (
          <div>
            <dt>{qualification.award}</dt>
            <dd>
              {qualification.institution}
              <span class="separator" aria-hidden="true">·</span>
              {/* A single <time> cannot express a span, so a multi-year
                  qualification gets one element per endpoint. */}
              <time datetime={qualification.startYear}>{qualification.startYear}</time>
              {qualification.endYear !== qualification.startYear && (
                <>
                  <span aria-hidden="true">&#8211;</span>
                  <time datetime={qualification.endYear}>{qualification.endYear}</time>
                </>
              )}
              {qualification.note && <span class="note">{qualification.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section" aria-labelledby="contact">
    <h2 id="contact">Contact</h2>
    <p set:html={contactLine} />
  </section>
</Base>

<style>
  .page-title {
    font-size: var(--text-h1);
    margin-block-end: calc(var(--spacing) * 8);
  }

  .bio > * + * {
    margin-block-start: calc(var(--spacing) * 6);
  }

  .section {
    margin-block-start: calc(var(--spacing) * 14);
    padding-block-start: calc(var(--spacing) * 6);
    border-top: 1px solid var(--color-rule);
  }

  .section > h2 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-block-end: calc(var(--spacing) * 8);
  }

  .education {
    margin: 0;
  }

  .education > div + div {
    margin-block-start: calc(var(--spacing) * 6);
  }

  .education dt {
    font-weight: 600;
  }

  .education dd {
    margin: calc(var(--spacing) * 1) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .separator {
    padding-inline: calc(var(--spacing) * 2);
  }

  .note::before {
    content: "·";
    padding-inline: calc(var(--spacing) * 2);
  }
</style>
