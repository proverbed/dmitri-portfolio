---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";

import Article from "../../layouts/Article.astro";
import { readingTime } from "../../lib/reading-time";
import { includeDrafts } from "../../lib/writing";

export const getStaticPaths = (async () => {
  // Drafts are routed in dev only. Building them in production would put them
  // in the sitemap, where `noindex` is the only thing standing between an
  // unfinished piece and a crawler — one flag away from a leak.
  const entries = await getCollection("writing", ({ data }) => includeDrafts || !data.draft);
  const ordered = entries.sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
  );

  // Neighbour links walk published entries only — a draft must not appear as
  // the "next" article on a live page.
  const published = ordered.filter((entry) => !entry.data.draft);

  return ordered.map((entry) => {
    const index = published.findIndex((candidate) => candidate.id === entry.id);
    const newer = index > 0 ? published[index - 1] : undefined;
    const older = index >= 0 ? published[index + 1] : undefined;

    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: older && { slug: older.id, title: older.data.title },
        next: newer && { slug: newer.id, title: newer.data.title },
      },
    };
  });
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const minutes = readingTime(entry.body ?? "");
---

<Article entry={entry} headings={headings} minutes={minutes} prev={prev} next={next}>
  <Content />
</Article>
