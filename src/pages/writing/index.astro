---
import Base from "../../layouts/Base.astro";
import { formatDate, isoDate } from "../../lib/format";
import { readingTime } from "../../lib/reading-time";
import { collectTags, getArticles } from "../../lib/writing";

const articles = await getArticles();
const tags = collectTags(articles);
---

<Base
  title="Writing"
  description="Essays on shipping software: edge deployment, verification, and infrastructure at its limits."
  width="annotated"
>
  <div class="layout">
    <header class="head">
      <h1>Writing</h1>
    </header>

    <aside class="margin">
      {
        tags.length > 0 && (
          <nav class="tags" aria-labelledby="filter-heading">
            <h2 id="filter-heading" class="label">
              Filter
            </h2>
            <ul>
              {tags.map((tag) => (
                <li>
                  <a href={`/writing/tag/${tag}`}>{tag}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </aside>

    <div class="body">
      {articles.length === 0 && <p class="empty">Nothing published yet.</p>}

      <ul class="articles">
        {
          articles.map((article) => (
            <li>
              <article>
                <p class="label meta">
                  <time datetime={isoDate(article.data.publishDate)}>
                    {formatDate(article.data.publishDate)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{readingTime(article.body ?? "")} min</span>
                  {article.data.draft && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span>Draft</span>
                    </>
                  )}
                </p>
                <h2>
                  <a href={`/writing/${article.id}`}>{article.data.title}</a>
                </h2>
                <p class="summary">{article.data.description}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: var(--margin-column) minmax(0, var(--container-measure));
    column-gap: var(--gutter);
  }

  .head {
    grid-column: 1 / -1;
    margin-block-end: calc(var(--spacing) * 12);
  }

  .head h1 {
    font-size: var(--text-h1);
  }

  .head::after {
    content: "";
    display: block;
    height: 2px;
    margin-block-start: calc(var(--spacing) * 8);
    background-color: var(--color-accent);
  }

  .margin {
    grid-column: 1;
  }

  .body {
    grid-column: 2;
  }

  .tags ul {
    margin: calc(var(--spacing) * 3) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .tags li + li {
    margin-block-start: calc(var(--spacing) * 2);
  }

  .articles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .articles > li {
    padding-block: calc(var(--spacing) * 8);
    border-top: 1px solid var(--color-rule);
  }

  .articles > li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 2);
    margin-block-end: calc(var(--spacing) * 3);
  }

  .articles h2 {
    font-size: var(--text-h3);
  }

  .articles h2 a {
    box-shadow: none;
  }

  .articles h2 a:hover {
    box-shadow: inset 0 -2px 0 0 var(--color-accent);
  }

  .summary {
    margin-block-start: calc(var(--spacing) * 3);
    color: var(--color-muted);
    line-height: var(--leading-snug);
  }

  .empty {
    color: var(--color-muted);
  }

  @media (max-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .margin,
    .body {
      grid-column: 1;
    }

    .margin {
      margin-block-end: calc(var(--spacing) * 10);
    }

    .tags ul {
      display: flex;
      flex-wrap: wrap;
      gap: calc(var(--spacing) * 4);
    }

    .tags li + li {
      margin-block-start: 0;
    }
  }
</style>
