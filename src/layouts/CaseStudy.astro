---
import { getEntry } from "astro:content";

import Base from "./Base.astro";
import Prose from "../components/Prose.astro";
import SpecBlock, { type SpecRow } from "../components/SpecBlock.astro";
import { SITE } from "../lib/site";
import type { CaseStudy } from "../lib/work";

interface Props {
  entry: CaseStudy;
}

const { entry } = Astro.props;
const { title, summary, period, domain, scale, constraint, tech, relatedWriting } = entry.data;

// Cross-links resolve against the writing collection at build time. A slug that
// names no article is a mistake in this file and fails the build; a slug that
// names a draft is simply not shown yet.
const related = (
  await Promise.all(
    relatedWriting.map(async (slug) => {
      const article = await getEntry("writing", slug);
      if (!article) {
        throw new Error(
          `Case study "${entry.id}" links to writing/"${slug}", which does not exist.`,
        );
      }
      return article;
    }),
  )
).filter((article) => !article.data.draft);

const ogImage = new URL(`/og/work/${entry.id}.png`, Astro.site ?? SITE.url).href;

const spec: SpecRow[] = [
  { label: "Period", value: period, mono: true },
  { label: "Domain", value: domain },
  ...(scale ? [{ label: "Scale", value: scale }] : []),
  { label: "Constraint", value: constraint },
  { label: "Stack", value: tech.join(" · "), mono: true },
];
---

<Base title={title} description={summary} width="annotated" ogImage={ogImage}>
  <article class="layout">
    <header class="head">
      <p class="label kicker"><a href="/work">Work</a></p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
    </header>

    <aside class="margin">
      <SpecBlock rows={spec} label="Project specification" />

      {
        related.length > 0 && (
          <nav class="related" aria-labelledby="related-writing">
            <h2 id="related-writing" class="label">
              Related writing
            </h2>
            <ul>
              {related.map((article) => (
                <li>
                  <a href={`/writing/${article.id}`}>{article.data.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </aside>

    <div class="body">
      <Prose>
        <slot />
      </Prose>
    </div>
  </article>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: var(--margin-column) minmax(0, var(--container-measure));
    column-gap: var(--gutter);
  }

  .head {
    grid-column: 1 / -1;
    margin-block-end: calc(var(--spacing) * 12);
  }

  .kicker {
    margin-block-end: calc(var(--spacing) * 5);
  }

  .kicker a {
    color: inherit;
    box-shadow: none;
  }

  .kicker a:hover {
    color: var(--color-text);
    box-shadow: none;
  }

  .head h1 {
    font-size: var(--text-h1);
  }

  .lede {
    margin-block-start: calc(var(--spacing) * 6);
    max-width: var(--container-measure);
    font-size: var(--text-lede);
    line-height: var(--leading-snug);
    color: var(--color-muted);
  }

  .head::after {
    content: "";
    display: block;
    height: 2px;
    margin-block-start: calc(var(--spacing) * 8);
    background-color: var(--color-accent);
  }

  .margin {
    grid-column: 1;
  }

  .body {
    grid-column: 2;
  }

  .related {
    margin-block-start: calc(var(--spacing) * 10);
  }

  .related ul {
    margin: calc(var(--spacing) * 3) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .related li + li {
    margin-block-start: calc(var(--spacing) * 3);
  }

  @media (max-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .margin,
    .body {
      grid-column: 1;
    }

    .margin {
      margin-block-end: calc(var(--spacing) * 12);
    }
  }
</style>
