---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

import Base from "./Base.astro";
import CodeCopy from "../components/CodeCopy.astro";
import Prose from "../components/Prose.astro";
import SpecBlock, { type SpecRow } from "../components/SpecBlock.astro";
import Toc from "../components/Toc.astro";
import { formatDate, isoDate } from "../lib/format";
import { SITE } from "../lib/site";

interface Sibling {
  slug: string;
  title: string;
}

interface Props {
  entry: CollectionEntry<"writing">;
  headings: readonly MarkdownHeading[];
  minutes: number;
  prev?: Sibling;
  next?: Sibling;
}

const { entry, headings, minutes, prev, next } = Astro.props;
const { title, description, publishDate, updatedDate, tags, draft } = entry.data;

const canonical = new URL(`/writing/${entry.id}`, Astro.site ?? SITE.url).href;
const ogImage = new URL(`/og/${entry.id}.png`, Astro.site ?? SITE.url).href;

const spec: SpecRow[] = [
  {
    label: "Published",
    value: formatDate(publishDate),
    datetime: isoDate(publishDate),
    mono: true,
  },
  ...(updatedDate
    ? [
        {
          label: "Updated",
          value: formatDate(updatedDate),
          datetime: isoDate(updatedDate),
          mono: true,
        },
      ]
    : []),
  { label: "Reading", value: `${minutes} min`, mono: true },
  ...(tags.length > 0 ? [{ label: "Tags", value: tags.join(" · "), mono: true }] : []),
  ...(draft ? [{ label: "Status", value: "Draft — not published", mono: true }] : []),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { "@type": "Person", name: SITE.name, url: SITE.url },
  publisher: { "@type": "Person", name: SITE.name, url: SITE.url },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  url: canonical,
  image: ogImage,
  ...(tags.length > 0 ? { keywords: tags.join(", ") } : {}),
  inLanguage: SITE.locale,
};
---

<Base
  title={title}
  description={description}
  type="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
  noindex={draft}
  ogImage={ogImage}
  width="annotated"
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <article class="layout">
    <header class="head">
      <p class="label kicker">Writing</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>

    {/* The margin carries what a manual would annotate with: the specification,
        then the contents. Both collapse above the text on narrow screens. */}
    <aside class="margin">
      <SpecBlock rows={spec} label="Article specification" />
      <Toc headings={headings} />
    </aside>

    <div class="body">
      <Prose>
        <slot />
      </Prose>

      {
        (prev || next) && (
          <nav class="pagination" aria-label="More writing">
            <div>
              {prev && (
                <a href={`/writing/${prev.slug}`} rel="prev">
                  <span class="label">Previous</span>
                  {prev.title}
                </a>
              )}
            </div>
            <div class="pagination-next">
              {next && (
                <a href={`/writing/${next.slug}`} rel="next">
                  <span class="label">Next</span>
                  {next.title}
                </a>
              )}
            </div>
          </nav>
        )
      }
    </div>
  </article>

  <CodeCopy />
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: var(--margin-column) minmax(0, var(--container-measure));
    column-gap: var(--gutter);
  }

  .head {
    grid-column: 1 / -1;
    margin-block-end: calc(var(--spacing) * 12);
  }

  .kicker {
    margin-block-end: calc(var(--spacing) * 5);
  }

  .head h1 {
    font-size: var(--text-h1);
  }

  .lede {
    margin-block-start: calc(var(--spacing) * 6);
    max-width: var(--container-measure);
    font-size: var(--text-lede);
    line-height: var(--leading-snug);
    color: var(--color-muted);
  }

  /* One rule under the title, in signal — the only place amber crosses the
     full measure on any page. */
  .head::after {
    content: "";
    display: block;
    height: 2px;
    margin-block-start: calc(var(--spacing) * 8);
    background-color: var(--color-accent);
  }

  .margin {
    grid-column: 1;
  }

  .body {
    grid-column: 2;
  }

  .pagination {
    display: grid;
    gap: calc(var(--spacing) * 6);
    margin-block-start: calc(var(--spacing) * 16);
    padding-block-start: calc(var(--spacing) * 6);
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-small);
  }

  @media (min-width: 40rem) {
    .pagination {
      grid-template-columns: 1fr 1fr;
    }

    .pagination-next {
      text-align: end;
    }
  }

  .pagination a {
    display: block;
    box-shadow: none;
    line-height: var(--leading-snug);
  }

  .pagination a:hover {
    box-shadow: none;
    color: var(--color-accent-text);
  }

  .pagination .label {
    display: block;
    margin-block-end: calc(var(--spacing) * 1);
  }

  @media (max-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .margin,
    .body {
      grid-column: 1;
    }

    .margin {
      margin-block-end: calc(var(--spacing) * 12);
    }
  }
</style>
