---
import Meta from "../components/Meta.astro";
import { NAV, SITE } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  ogImage?: string;
  /** Article pages set the narrow measure; index pages get the wider one. */
  width?: "measure" | "wide" | "cards";
}

const {
  title,
  description,
  type,
  publishDate,
  updatedDate,
  noindex,
  ogImage,
  width = "wide",
} = Astro.props;

const CONTAINERS = {
  measure: "max-w-measure",
  wide: "max-w-wide",
  cards: "max-w-cards",
} as const;

const container = CONTAINERS[width];
const path = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- The roman face renders every glyph above the fold; italic and mono are
         discovered from CSS only when a page actually uses them. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      crossorigin
    />

    <Meta
      title={title}
      description={description}
      type={type}
      publishDate={publishDate}
      updatedDate={updatedDate}
      noindex={noindex}
      ogImage={ogImage}
    />
    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class={`mx-auto flex min-h-screen w-full flex-col px-5 sm:px-8 ${container}`}>
      <header class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-4 py-8">
        <a href="/" class="site-name" aria-current={path === "" ? "page" : undefined}>
          {SITE.name}
        </a>

        <nav aria-label="Primary">
          <ul class="nav-list">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={path === item.href || path.startsWith(`${item.href}/`) ? "page" : undefined}
                    class="nav-link"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>

      <main id="main" tabindex="-1" class="w-full flex-1 py-4">
        <slot />
      </main>

      <footer class="mt-20 border-t border-rule py-8 text-sm text-muted">
        <p>&copy; {new Date().getFullYear()} {SITE.name}</p>
      </footer>
    </div>

    <style>
      .site-name {
        display: inline-block;
        padding-block: calc(var(--spacing) * 1.5);
        font-weight: 600;
        text-decoration: none;
      }

      .nav-list {
        display: flex;
        gap: calc(var(--spacing) * 6);
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: var(--text-sm);
      }

      /* Padded to clear the 24px minimum tap target on touch screens; the text
         itself is only 21px tall at this size. */
      .nav-link {
        display: inline-block;
        padding-block: calc(var(--spacing) * 1.5);
        text-decoration: none;
      }

      .nav-link[aria-current="page"] {
        text-decoration: underline;
      }

      .skip-link {
        position: absolute;
        left: calc(var(--spacing) * 4);
        top: calc(var(--spacing) * 4);
        z-index: 10;
        padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
        background-color: var(--color-surface);
        border: 1px solid var(--color-rule);
        border-radius: var(--radius-md);
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus-visible {
        transform: translateY(0);
      }

      #main:focus {
        outline: none;
      }
    </style>
  </body>
</html>
