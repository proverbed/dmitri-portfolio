---
import Meta from "../components/Meta.astro";
import { NAV, SITE } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  ogImage?: string;
  /**
   * `annotated` gives the page the manual's margin column; `measure` is a
   * single text column; `cards` is the wider grid used by the work index.
   */
  width?: "annotated" | "measure" | "cards";
}

const {
  title,
  description,
  type,
  publishDate,
  updatedDate,
  noindex,
  ogImage,
  width = "measure",
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Both faces that render above the fold are preloaded. Dropping the body
         face bought ~0.1s of mobile LCP and cost 0.23 CLS on the runs where its
         swap landed after first paint; the size-adjust fallbacks narrow that
         shift but do not remove it. Arriving late is worse than arriving. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/archivo-600-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      crossorigin
    />

    <Meta
      title={title}
      description={description}
      type={type}
      publishDate={publishDate}
      updatedDate={updatedDate}
      noindex={noindex}
      ogImage={ogImage}
    />
    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class:list={["page", `page-${width}`]}>
      <header class="masthead">
        <a class="wordmark" href="/">{SITE.name}</a>

        <nav aria-label="Primary">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={
                      path === item.href || path.startsWith(`${item.href}/`) ? "page" : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>

      <main id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="colophon">
        <p class="label">&copy; {new Date().getFullYear()} {SITE.name}</p>
        <p class="label">
          <a href="/rss.xml">RSS</a>
        </p>
      </footer>
    </div>

    <style>
      .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin-inline: auto;
        padding-inline: calc(var(--spacing) * 6);
      }

      /* The annotated width is the margin column plus the text column; the
         masthead rule spans both, which is what it is aligned to. */
      .page-annotated {
        max-width: calc(var(--margin-column) + var(--gutter) + var(--container-measure));
      }

      .page-measure {
        max-width: var(--container-measure);
      }

      .page-cards {
        max-width: var(--container-cards);
      }

      .masthead {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: calc(var(--spacing) * 4) calc(var(--spacing) * 8);
        padding-block: calc(var(--spacing) * 7);
        border-bottom: 1px solid var(--color-rule);
      }

      .wordmark {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.0625rem;
        letter-spacing: -0.01em;
        box-shadow: none;
      }

      .wordmark:hover {
        box-shadow: inset 0 -2px 0 0 var(--color-accent);
      }

      .masthead nav ul {
        display: flex;
        gap: calc(var(--spacing) * 7);
        margin: 0;
        padding: 0;
        list-style: none;
        font-family: var(--font-mono);
        font-size: var(--text-label);
        text-transform: uppercase;
        letter-spacing: var(--tracking-label);
      }

      .masthead nav a {
        display: inline-block;
        padding-block: calc(var(--spacing) * 1.5);
        color: var(--color-muted);
        box-shadow: none;
      }

      .masthead nav a:hover {
        color: var(--color-text);
        box-shadow: none;
      }

      /* The active item is the one lamp in the masthead. */
      .masthead nav a[aria-current="page"] {
        color: var(--color-text);
        box-shadow: inset 0 -2px 0 0 var(--color-accent);
      }

      main {
        flex: 1;
        padding-block: calc(var(--spacing) * 16) calc(var(--spacing) * 20);
      }

      .colophon {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: calc(var(--spacing) * 3);
        padding-block: calc(var(--spacing) * 7);
        border-top: 1px solid var(--color-rule);
      }

      .colophon a {
        color: inherit;
      }

      .skip-link {
        position: absolute;
        left: calc(var(--spacing) * 4);
        top: calc(var(--spacing) * 4);
        z-index: 10;
        padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
        background-color: var(--color-bg);
        border: 1px solid var(--color-rule);
        box-shadow: none;
        font-family: var(--font-mono);
        font-size: var(--text-label);
        text-transform: uppercase;
        letter-spacing: var(--tracking-label);
        transform: translateY(-250%);
      }

      .skip-link:focus-visible {
        transform: translateY(0);
      }

      #main:focus {
        outline: none;
      }
    </style>
  </body>
</html>
