---
import type { CaseStudy } from "../lib/work";

interface Props {
  entry: CaseStudy;
}

const { entry } = Astro.props;
const { title, summary, period, domain, tech } = entry.data;
---

{/* A row on an index, not a card: hairline-separated, with the period held in
    its own column so the four line up as a table of contents would. */}
<article class="entry">
  <p class="label period">{period}</p>

  <div>
    <h2>
      <a href={`/work/${entry.id}`}>{title}</a>
    </h2>
    <p class="domain label">{domain}</p>
    <p class="summary">{summary}</p>
    <p class="stack label">{tech.join(" · ")}</p>
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    column-gap: var(--gutter);
    padding-block: calc(var(--spacing) * 9);
    border-top: 1px solid var(--color-rule);
  }

  .period {
    font-variant-numeric: tabular-nums;
  }

  .entry h2 {
    font-size: var(--text-h3);
  }

  .entry h2 a {
    box-shadow: none;
  }

  .entry h2 a:hover {
    box-shadow: inset 0 -2px 0 0 var(--color-accent);
  }

  .domain {
    margin-block-start: calc(var(--spacing) * 2);
  }

  .summary {
    margin-block-start: calc(var(--spacing) * 4);
    color: var(--color-muted);
    line-height: var(--leading-snug);
  }

  .stack {
    margin-block-start: calc(var(--spacing) * 4);
  }

  @media (max-width: 48rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      row-gap: calc(var(--spacing) * 3);
    }
  }
</style>
