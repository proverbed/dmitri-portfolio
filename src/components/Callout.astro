---
type Variant = "note" | "warning" | "aside";

interface Props {
  variant?: Variant;
  /** Visible label; also the accessible name of the region. */
  title?: string;
}

const { variant = "note", title } = Astro.props;

const DEFAULT_TITLE: Record<Variant, string> = {
  note: "Note",
  warning: "Warning",
  aside: "Aside",
};

const label = title ?? DEFAULT_TITLE[variant];
---

<aside class:list={["callout", `callout-${variant}`]} aria-label={label}>
  <p class="callout-title">{label}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    padding: calc(var(--spacing) * 4) calc(var(--spacing) * 5);
    border-inline-start: 3px solid var(--color-rule);
    background-color: var(--color-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .callout-note {
    border-inline-start-color: var(--color-accent);
  }

  /* Warning uses weight and a hue shift, not a red panel; the distinction has
     to survive being read in greyscale. */
  .callout-warning {
    border-inline-start-color: oklch(0.62 0.16 45);
  }

  .callout-title {
    font-size: var(--text-sm);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-block-end: calc(var(--spacing) * 2);
  }

  .callout-body :global(> * + *) {
    margin-block-start: calc(var(--spacing) * 3);
  }
</style>
