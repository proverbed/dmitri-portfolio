---
type Variant = "note" | "warning" | "aside";

interface Props {
  variant?: Variant;
  /** Visible label; also the accessible name of the region. */
  title?: string;
}

const { variant = "note", title } = Astro.props;

const DEFAULT_TITLE: Record<Variant, string> = {
  note: "Note",
  warning: "Warning",
  aside: "Aside",
};

const label = title ?? DEFAULT_TITLE[variant];
---

<aside class:list={["callout", `callout-${variant}`]} aria-label={label}>
  <p class="callout-title">{label}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  /* No fill and no radius: an annotation in a manual is marked by a rule in the
     margin, not by a tinted panel. Warning is distinguished by the rule turning
     signal — which is exactly what amber means on a flight deck. */
  .callout {
    padding-inline-start: calc(var(--spacing) * 5);
    border-inline-start: 2px solid var(--color-rule);
  }

  .callout-warning {
    border-inline-start-color: var(--color-accent);
  }

  .callout-title {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-muted);
    margin-block-end: calc(var(--spacing) * 2);
  }

  .callout-body :global(> * + *) {
    margin-block-start: calc(var(--spacing) * 3);
  }
</style>
