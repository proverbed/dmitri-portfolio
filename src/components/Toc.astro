---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: readonly MarkdownHeading[];
  /** A contents list only earns its place past this many top-level sections. */
  threshold?: number;
}

const { headings, threshold = 4 } = Astro.props;

// h2 only, and never the GFM footnotes heading — that is apparatus, not a
// section of the argument.
const sections = headings.filter(
  (heading) => heading.depth === 2 && heading.slug !== "footnote-label",
);
const show = sections.length > threshold;
---

{
  show && (
    <nav class="toc" aria-labelledby="toc-heading">
      <h2 id="toc-heading" class="label">
        Contents
      </h2>
      <ol>
        {sections.map((section, index) => (
          <li>
            <span class="index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <a href={`#${section.slug}`}>{section.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    margin-block-start: calc(var(--spacing) * 10);
  }

  .toc ol {
    margin: calc(var(--spacing) * 3) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .toc li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
  }

  .toc li + li {
    margin-block-start: calc(var(--spacing) * 3);
  }

  /* Numbered because the sections of an argument genuinely are sequential —
     not as decoration. Tabular so the column stays true past nine. */
  .index {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .toc a {
    box-shadow: none;
  }

  .toc a:hover {
    box-shadow: inset 0 -2px 0 0 var(--color-accent);
  }
</style>
