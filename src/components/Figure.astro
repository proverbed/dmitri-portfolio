---
interface Props {
  src?: string;
  alt?: string;
  caption: string;
  /** Widen past the reading measure for wide diagrams and screenshots. */
  bleed?: boolean;
}

const { src, alt, caption, bleed = false } = Astro.props;
---

<figure class:list={["figure", bleed && "figure-bleed"]}>
  {src ? <img src={src} alt={alt ?? ""} loading="lazy" decoding="async" /> : <slot />}
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .figure {
    margin-inline: 0;
  }

  .figure img {
    display: block;
    width: 100%;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
  }

  figcaption {
    margin-block-start: calc(var(--spacing) * 3);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-muted);
  }

  /* Wide figures escape the reading measure symmetrically, but only once the
     viewport is wide enough that doing so does not cause a horizontal scroll. */
  @media (min-width: 64rem) {
    .figure-bleed {
      width: min(56rem, calc(100vw - var(--spacing) * 16));
      margin-inline-start: 50%;
      transform: translateX(-50%);
    }
  }
</style>
